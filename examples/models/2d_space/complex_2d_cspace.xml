<mujoco model="robot">
  <default class="default">
    <geom rgba="0.94 0.5 0.5 1" mass="1.0"/>
  </default>
  <worldbody>
    <!-- border -->
    <geom type="box" pos="5 -0.05 0" size="5.1 0.05 1" rgba="0 0 0 1" />
    <geom type="box" pos="5 4.05 0" size="5.1 0.05 1" rgba="0 0 0 1" />
    <geom type="box" pos="-0.05 2 0" size="0.05 2.1 1" rgba="0 0 0 1" />
    <geom type="box" pos="10.05 2 0" size="0.05 2.1 1" rgba="0 0 0 1" />

    <!-- obstacles 1-->
    <!-- <geom type="box" pos="2 2 0" size="0.25 1.0 1" class="default" /> -->

    <!-- obstacles 2-->
    <geom type="box" pos="2 1.5 0" size="1 0.5 1" euler="0 0 0" class="default" />
    <geom type="box" pos="5 2.5 0" size="1 0.5 1" euler="0 0 0" class="default" />
    <geom type="box" pos="8 1.5 0" size="1 0.5 1" euler="0 0 0" class="default" />

    <!-- robot -->
    <body name="robot" pos="0 0 0">
      <geom type="sphere" pos="0 0 0" size="0.01" rgba="0 0 1 1" mass="1" />
      <joint type="slide" name="x" axis="1 0 0" range="0 10" limited="true"/>
      <joint type="slide" name="y" axis="0 1 0" range="0 4" limited="true"/>
    </body>
  </worldbody>
</mujoco>